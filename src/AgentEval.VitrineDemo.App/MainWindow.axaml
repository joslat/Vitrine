<!-- SPDX-License-Identifier: MIT -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AgentEval.VitrineDemo.App.ViewModels"
        xmlns:controls="using:AgentEval.VitrineDemo.App.Controls"
        xmlns:evalLive="using:AgentEval.VitrineDemo.Evals.Live"
        x:Class="AgentEval.VitrineDemo.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="VITRINE · AgentEval Control Room"
        Width="1480"
        Height="900"
        MinWidth="1040"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
  <Window.Resources>
    <vm:RunModeDisplayConverter x:Key="RunModeDisplay" />
  </Window.Resources>
  <Grid RowDefinitions="72,Auto,*,34">
    <Border Grid.Row="0" Background="#0D1422" BorderBrush="#24314A" BorderThickness="0,0,0,1" Padding="18,10">
      <Grid ColumnDefinitions="320,*,Auto,Auto,Auto" ColumnSpacing="9">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="VITRINE · AGENTEVAL" Classes="eyebrow" />
          <TextBlock Text="Evidence Control Room" FontSize="20" FontWeight="SemiBold" Foreground="#F5F8FF" />
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0">
          <TextBlock Text="{Binding Status}" Foreground="#C7D5EA" FontWeight="SemiBold" />
          <TextBlock Text="{Binding LiveReadiness}" Classes="muted" FontSize="10" />
        </StackPanel>
        <Button Grid.Column="2" Content="{Binding RunButtonText}" Command="{Binding RunCommand}" Classes="primary" AutomationProperties.Name="Run selected VITRINE mode"
                ToolTip.Tip="Start the selected mode with the shown persona and execution arm. Live Azure is enabled only when explicitly selected and configured." />
        <Button Grid.Column="3" Content="CANCEL" Command="{Binding CancelCommand}" IsEnabled="{Binding IsRunning}" Classes="danger" AutomationProperties.Name="Cancel active run"
                ToolTip.Tip="Cancel only the active run. It is visibly disabled when no run is executing; events already observed remain available." />
        <Button Grid.Column="4" Content="CLEAR" Command="{Binding ClearCommand}" AutomationProperties.Name="Clear current run view"
                ToolTip.Tip="Clear run evidence and restore the honest pre-run topology preview for the selected mode." />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="#0A101D"
            BorderBrush="#202C41"
            BorderThickness="0,0,0,1"
            HorizontalAlignment="Stretch">
      <Expander IsExpanded="{Binding IsSetupExpanded}"
                Width="{Binding $parent[Border].Bounds.Width}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="Run configuration and evidence actions">
        <Expander.Header>
          <Border Background="#0E1726"
                  BorderBrush="#263753"
                  BorderThickness="0,0,0,1"
                  Padding="16,9"
                  HorizontalAlignment="Stretch"
                  Cursor="Hand"
                  ToolTip.Tip="Open or collapse the run selector and artifact actions. Collapse it to maximize the live graph and event timeline.">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <TextBlock Text="RUN CONFIGURATION" Foreground="#72B6FF" FontSize="10" FontWeight="Bold" />
                <Border Background="#17243A" BorderBrush="#30496F" BorderThickness="1" CornerRadius="5" Padding="7,3">
                  <TextBlock Text="MODE · PERSONA · EXECUTION ARM · EXPORT" Foreground="#9FC5FF" FontSize="8" FontWeight="Bold" />
                </Border>
              </StackPanel>
              <TextBlock Grid.Column="1"
                         Text="{Binding SetupSelectionSummary}"
                         Foreground="#A9B8CE"
                         FontSize="10"
                         Margin="18,0"
                         VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2"
                         Text="{Binding SetupPanelAction}"
                         Foreground="#72B6FF"
                         FontSize="9"
                         FontWeight="Bold"
                         VerticalAlignment="Center" />
            </Grid>
          </Border>
        </Expander.Header>

        <StackPanel>
          <Border Background="#0A101D" Padding="14,9">
            <WrapPanel VerticalAlignment="Center" IsEnabled="{Binding !IsRunning}">
              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="MODE" Classes="eyebrow" />
                <ComboBox Width="220" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" AutomationProperties.Name="Run mode"
                          ToolTip.Tip="Demo01 runs a ChatClientAgent and registered read-only tools. Demo02 runs the five-executor MAF workflow. Offline Evals measures both use cases. Catalogue integrity self-test removes one isolated catalogue row and should return exit 1, then restores state.">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:VitrineRunMode">
                      <TextBlock Text="{Binding Converter={StaticResource RunModeDisplay}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Margin="0,0,14,0" IsVisible="{Binding IsDemoMode}">
                <TextBlock Text="PERSONA" Classes="eyebrow" />
                <ComboBox Width="250" ItemsSource="{Binding Setup.Personas}" SelectedItem="{Binding Setup.SelectedPersona}" AutomationProperties.Name="Customer persona"
                          ToolTip.Tip="Select the typed customer profile supplied to the demo. Personal history enters only when personalization is enabled and the profile permits it." />
              </StackPanel>
              <StackPanel Margin="0,0,14,0" IsVisible="{Binding IsDemoMode}">
                <TextBlock Text="EXECUTION ARM" Classes="eyebrow" />
                <ComboBox Width="230" ItemsSource="{Binding Setup.Arms}" SelectedItem="{Binding Setup.SelectedArm}" AutomationProperties.Name="Execution arm"
                          ToolTip.Tip="Choose the execution boundary: deterministic mocked model over real runtime, code-only zero-model baseline, or explicitly configured paid Azure execution." />
                <TextBlock Width="230" Text="{Binding Setup.ArmDescription}" Classes="muted" FontSize="9" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,14,0" IsVisible="{Binding IsProfiledEvaluationMode}">
                <TextBlock Text="EVALUATION PLAN" Classes="eyebrow" />
                <ComboBox Width="330"
                          ItemsSource="{Binding Setup.EvaluationPlans}"
                          SelectedItem="{Binding Setup.SelectedEvaluationPlan}"
                          AutomationProperties.Name="Evaluation plan"
                          ToolTip.Tip="Offline remains the safe default. Eval 01 runs the agent; Eval 02 the workflow; Eval 03 compares matched arms; Eval 04/05 report stochastic reliability; Eval 06 runs bounded AgentEval safety probes against Robin only.">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="evalLive:VitrineEvaluationPlanDescriptor">
                      <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Width="330" Text="{Binding Setup.EvaluationPlanDescription}" Classes="muted" FontSize="9" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Margin="0,0,14,0" IsVisible="{Binding IsLiveScenarioEvaluationMode}">
                <TextBlock Text="LIVE USE CASE" Classes="eyebrow" />
                <ComboBox Width="300" ItemsSource="{Binding Setup.LiveScenarios}" SelectedItem="{Binding Setup.SelectedLiveScenario}"
                          AutomationProperties.Name="Live evaluation use case"
                          ToolTip.Tip="Run one canonical use case to control spend, or all four as separate stable benchmark cases." />
              </StackPanel>
              <StackPanel Margin="0,0,14,0" IsVisible="{Binding IsStochasticEvaluationMode}">
                <TextBlock Text="REPETITIONS" Classes="eyebrow" />
                <NumericUpDown Width="115" Minimum="{Binding Setup.MinimumEvaluationRepetitions}" Maximum="30" Value="{Binding Setup.EvaluationRepetitions}"
                               AutomationProperties.Name="Live evaluation repetitions"
                               ToolTip.Tip="One AgentEval BenchmarkRunner run is persisted per arm and repetition. Stochastic plans require at least four repetitions so an all-success 95% Wilson interval can clear the registered 0.50 floor." />
              </StackPanel>
              <StackPanel Margin="0,0,14,0" IsVisible="{Binding IsLiveEvaluationMode}" MaxWidth="270">
                <TextBlock Text="PAID EXECUTION" Classes="eyebrow" />
                <ToggleSwitch IsChecked="{Binding Setup.PaidEvaluationAcknowledged}" OnContent="confirmed" OffContent="not confirmed"
                              AutomationProperties.Name="Confirm paid live evaluation"
                              ToolTip.Tip="This must be switched right before Run is enabled. Live evals never fall back to offline subjects." />
              </StackPanel>
              <StackPanel Margin="0,0,14,0" IsVisible="{Binding IsDemoMode}">
                <TextBlock Text="PERSONALIZATION" Classes="eyebrow" />
                <ToggleSwitch IsChecked="{Binding Setup.PersonalizationEnabled}" OnContent="enabled" OffContent="disabled" AutomationProperties.Name="Enable personalization"
                              ToolTip.Tip="When switched right and labelled enabled, permitted profile/history signals may enter the run. When off, they are withheld from the subject." />
              </StackPanel>
              <StackPanel Margin="0,0,14,0" IsVisible="{Binding IsDemo02Mode}">
                <TextBlock Text="MAX ROUNDS" Classes="eyebrow" />
                <NumericUpDown Width="115" Minimum="1" Maximum="6" Value="{Binding Setup.MaxRounds}" AutomationProperties.Name="Maximum workflow rounds"
                               ToolTip.Tip="Hard cap for Demo02 discovery rounds, including any coverage-review loop-back. This prevents an unbounded workflow." />
              </StackPanel>
              <StackPanel Margin="0,0,14,0">
                <TextBlock Text="AUDIENCE PACE · MS" Classes="eyebrow" />
                <NumericUpDown Width="105" Minimum="0" Maximum="1000" Increment="30" Value="{Binding Setup.AudiencePacingMilliseconds}" AutomationProperties.Name="Audience pacing milliseconds"
                               ToolTip.Tip="Presentation delay per event. It never slows, changes, or supplies input to the authoritative execution; use 0 for immediate projection." />
                <TextBlock Text="RUN DONE · PRESENTING" IsVisible="{Binding IsPresentationActive}"
                           Foreground="#5AE4D2" FontSize="9" FontWeight="Bold"
                           ToolTip.Tip="Authoritative execution has finished. Only already-recorded events are still being paced onto the screen; changing pace cannot change the result." />
              </StackPanel>
            </WrapPanel>
          </Border>

          <Border Background="#0D1727" BorderBrush="#253653" BorderThickness="0,1,0,0" Padding="16,10"
                  IsVisible="{Binding IsDemoMode}"
                  ToolTip.Tip="This is the exact authored scenario and canonical customer request that the selected demo will receive; it is visible before any run starts.">
            <Grid ColumnDefinitions="2*,3*" ColumnSpacing="22">
              <StackPanel>
                <TextBlock Text="AUTHORED SCENARIO" Classes="eyebrow" />
                <TextBlock Text="{Binding Setup.ScenarioTitle}" Foreground="#F3F7FD" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Setup.ScenarioDescription}" Foreground="#9FC5FF" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="EXACT CUSTOMER QUERY" Classes="eyebrow" />
                <SelectableTextBlock Text="{Binding Setup.ScenarioQuery}" Foreground="#D8E5F6" FontFamily="Cascadia Mono, Consolas"
                                     FontSize="10" TextWrapping="Wrap" AutomationProperties.Name="Exact canonical customer query" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Background="#0D1727" BorderBrush="#253653" BorderThickness="0,1,0,0" Padding="16,10"
                  IsVisible="{Binding IsLiveScenarioEvaluationMode}"
                  ToolTip.Tip="The selected paid benchmark case(s), expected behavior, and exact canonical query are visible before any model call starts.">
            <Grid ColumnDefinitions="2*,3*" ColumnSpacing="22">
              <StackPanel>
                <TextBlock Text="LIVE EVAL SCENARIO" Classes="eyebrow" />
                <TextBlock Text="{Binding Setup.EvaluationScenarioTitle}" Foreground="#F3F7FD" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Setup.EvaluationScenarioDescription}" Foreground="#9FC5FF" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="EXACT CUSTOMER QUERY / CASE SET" Classes="eyebrow" />
                <SelectableTextBlock Text="{Binding Setup.EvaluationScenarioQuery}" Foreground="#D8E5F6" FontFamily="Cascadia Mono, Consolas"
                                     FontSize="10" TextWrapping="Wrap" AutomationProperties.Name="Selected live evaluation query" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Background="#0D1727" BorderBrush="#253653" BorderThickness="0,1,0,0" Padding="16,10"
                  IsVisible="{Binding IsSafetyEvaluationMode}"
                  ToolTip.Tip="Eval 06 invokes the released AgentEval red-team runner. Its in-memory extraction canary and all raw prompts/responses are excluded from UI and artifact evidence.">
            <Grid ColumnDefinitions="2*,3*" ColumnSpacing="22">
              <StackPanel>
                <TextBlock Text="ROBIN-ONLY SAFETY TARGET" Classes="eyebrow" />
                <TextBlock Text="2 attack categories × up to 2 probes" Foreground="#F3F7FD" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="Jailbreak + system/instruction extraction · 4 target probe invocations · each capped at 25 target model turns + 1 fallback judge · 104 maximum safety model calls."
                           Foreground="#9FC5FF" FontSize="10" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="REDACTED EVIDENCE CONTRACT" Classes="eyebrow" />
                <TextBlock Text="A fresh Robin target is canary-instrumented in memory. Only probe category/id, outcome, fidelity, technique, severity, and error kind cross the boundary; no raw canary, probe, response, or system instruction is stored."
                           Foreground="#D8E5F6" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <Border Background="#101A2B" BorderBrush="#253653" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid ColumnDefinitions="2*,3*,Auto" ColumnSpacing="18">
              <TextBlock Text="{Binding ModeExplanation}" Foreground="#9FC5FF" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding ResultSummary}" Foreground="#D9E5F7" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ReplayStatus}" Foreground="#7184A1" FontSize="9" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="JSON" Command="{Binding ExportJsonCommand}" AutomationProperties.Name="Export sanitized JSON artifact"
                        ToolTip.Tip="Save the completed run as an integrity-protected, sanitized JSON artifact. Disabled until a run has produced an artifact." />
                <Button Content="HTML" Command="{Binding ExportHtmlCommand}" AutomationProperties.Name="Export self-contained HTML report"
                        ToolTip.Tip="Save a self-contained human-readable HTML report from the same sanitized artifact. Disabled until completion." />
                <Button Content="REPLAY" Command="{Binding StartReplayCommand}" AutomationProperties.Name="Start pure replay"
                        ToolTip.Tip="Reset the graph and timeline, then replay stored events without calling a model, tool, workflow, or evaluator." />
                <Button Content="◀" Command="{Binding ReplayPreviousCommand}" AutomationProperties.Name="Previous replay event"
                        ToolTip.Tip="Move one stored event backward and deterministically rebuild graph states and counters from the artifact." />
                <Button Content="▶" Command="{Binding ReplayNextCommand}" AutomationProperties.Name="Next replay event"
                        ToolTip.Tip="Project the next stored event. This performs zero execution operations." />
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Expander>
    </Border>

    <TabControl Grid.Row="2" Margin="12" Padding="0">
      <TabItem Header="LIVE CONTROL ROOM" ToolTip.Tip="Inspect topology, direction, run counts, typed workflow actions, screened outcome, and the ordered event stream." >
        <Grid ColumnDefinitions="1.75*,6,1*" Margin="0,10,0,0">
          <ScrollViewer Grid.Column="0"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
          <Border Classes="card" Padding="12">
            <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="RUNTIME-DERIVED GRAPH" Classes="eyebrow" />
                  <TextBlock Text="{Binding Graph.Title}" Classes="heading" FontSize="17" />
                  <TextBlock Text="{Binding Graph.Provenance}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Classes="chip" VerticalAlignment="Top"
                        ToolTip.Tip="PRE-RUN PREVIEW is an explicitly labelled contract/factory projection. RUNTIME FACTS means the active run supplied the topology.">
                  <TextBlock Text="{Binding Graph.BadgeText}" Foreground="{Binding Graph.BadgeColor}" FontSize="9" FontWeight="Bold" />
                </Border>
              </Grid>

              <controls:RuntimeGraphControl Grid.Row="1"
                                            Model="{Binding Graph}"
                                            Revision="{Binding Graph.GraphRevision}"
                                            MinHeight="390"
                                            Margin="0,10"
                                            ToolTip.Tip="Every connector arrow points from source to target. Node ×N counts starts; connector ×N counts typed directed observations. Demo02 predicate traces are observations, not round counts."
                                            AutomationProperties.Name="Runtime graph visualization" />

              <Border Grid.Row="2" Classes="inner" IsVisible="{Binding Graph.ShowActionShelf}" Margin="0,0,0,8"
                      ToolTip.Tip="Demo02 does not register AIFunction tools. This shelf truthfully lists typed executor starts, model-call measurements, and Search events emitted by the workflow.">
                <StackPanel Spacing="6">
                  <TextBlock Text="ACTIONS · TYPED WORKFLOW OBSERVATIONS · NOT AIFUNCTION TOOLS" Classes="eyebrow" />
                  <TextBlock Text="{Binding Graph.ActionsSummary}" Classes="muted" FontSize="9" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Graph.Actions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GraphActionViewModel">
                        <Border Classes="chip" Margin="0,0,7,4" MaxWidth="240">
                          <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Kind}" Classes="eyebrow" />
                              <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="#5AE4D2" FontSize="9" FontWeight="Bold" />
                            </Grid>
                            <TextBlock Text="{Binding Label}" Foreground="#E7EEF9" FontSize="10" />
                            <TextBlock Text="{Binding LastDetail}" Classes="muted" FontSize="8" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Expander Grid.Row="3" Header="Accessible node and edge list" IsExpanded="False"
                        ToolTip.Tip="Open a text alternative for the graph, including current state and reconstructed execution/connector counts.">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                  <ScrollViewer MaxHeight="170">
                    <ItemsControl ItemsSource="{Binding Graph.Nodes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GraphNodeViewModel">
                          <Border Classes="listRow" Margin="0,0,0,5">
                            <Grid ColumnDefinitions="100,*,Auto,Auto" ColumnSpacing="8">
                              <TextBlock Text="{Binding Kind}" Classes="eyebrow" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#E7EEF9" TextWrapping="Wrap" />
                              <TextBlock Grid.Column="2" Text="{Binding StateText}" Foreground="{Binding StateColor}" FontSize="9" FontWeight="Bold" />
                              <TextBlock Grid.Column="3" Text="{Binding ExecutionText}" Foreground="#8FA3C0" FontSize="9" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <ScrollViewer Grid.Column="1" MaxHeight="170">
                    <ItemsControl ItemsSource="{Binding Graph.Edges}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GraphEdgeViewModel">
                          <Border Classes="listRow" Margin="0,0,0,5">
                            <StackPanel>
                              <TextBlock Text="{Binding SourceId}" Foreground="#E7EEF9" />
                              <TextBlock Text="{Binding TargetId, StringFormat='→ {0}'}" Foreground="#A9BAD2" />
                              <TextBlock Text="{Binding Label}" Classes="muted" FontSize="9" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding TraversalText}" Foreground="#B77CFF" FontSize="9" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Expander>

              <Expander Grid.Row="4" IsExpanded="{Binding IsOutcomeExpanded}" Margin="0,8,0,0"
                        ToolTip.Tip="Open the sanitized final customer-facing response and supporting run facts. It opens automatically when a run completes."
                        AutomationProperties.Name="Screened run outcome">
                <Expander.Header>
                  <TextBlock Text="{Binding OutcomeTitle}" Classes="eyebrow" TextWrapping="Wrap" />
                </Expander.Header>
                <Border Classes="inner" Margin="0,8,0,0">
                  <ScrollViewer MaxHeight="240">
                    <TextBlock Text="{Binding OutcomeDetails}" Foreground="#C9D6E8" FontSize="10"
                               TextWrapping="Wrap" Classes="mono" />
                  </ScrollViewer>
                </Border>
              </Expander>
            </Grid>
          </Border>
          </ScrollViewer>

          <GridSplitter Grid.Column="1" Background="#26334A" ResizeDirection="Columns" />

          <Border Grid.Column="2" Classes="card" Padding="10">
            <Grid RowDefinitions="Auto,2*,6,*">
              <Grid ColumnDefinitions="*,155,Auto" ColumnSpacing="8" Margin="2,0,2,8">
                <StackPanel>
                  <TextBlock Text="EVENT TIMELINE" Classes="eyebrow" />
                  <TextBlock Text="{Binding Timeline.VisibleCount, StringFormat='{}{0} visible events'}" Classes="heading" FontSize="14" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Timeline.Filters}" SelectedItem="{Binding Timeline.SelectedFilter}" AutomationProperties.Name="Timeline filter"
                          ToolTip.Tip="Choose which already-observed events are visible: Story, Tools/model boundaries, Guards, Evals, or all Debug events. Filtering never changes the stored run." />
                <ToggleSwitch Grid.Column="2"
                              IsChecked="{Binding Timeline.FollowEvents}"
                              OnContent="follow"
                              OffContent="paused"
                              ToolTip.Tip="When switched right, select the newest visible event automatically. Switch left to keep your current inspection selection while execution continues."
                              AutomationProperties.Name="Follow newest visible event" />
              </Grid>

              <ListBox x:Name="EventTimelineList" Grid.Row="1" ItemsSource="{Binding Timeline.Events}" SelectedItem="{Binding Timeline.SelectedEvent}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Run event timeline">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EventCardViewModel">
                    <Border Classes="eventCard" IsVisible="{Binding IsVisible}" Margin="0,0,0,7" Padding="9">
                      <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="{Binding Sequence, StringFormat='#{0}'}" Foreground="#7184A1" FontSize="9" />
                        <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#72B6FF" FontSize="9" FontWeight="Bold" Margin="8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Elapsed}" Foreground="#7184A1" FontSize="9" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Title}" Foreground="#F3F7FD" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,2" />
                        <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                          <TextBlock Text="{Binding Route}" Classes="muted" FontSize="9" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="{Binding Disposition}" Foreground="{Binding DispositionColor}" FontSize="9" FontWeight="Bold" Margin="8,0,0,0" />
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding OperationId}" IsVisible="{Binding HasOperationId}"
                                     Foreground="#657995" FontFamily="Cascadia Mono, Consolas" FontSize="8" TextWrapping="Wrap" />
                        </Grid>
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,7,0,0">
                          <Button Content="{Binding ExpandControlText}"
                                  Command="{Binding ToggleExpandedCommand}"
                                  IsVisible="{Binding IsExpandControlVisible}"
                                  HorizontalAlignment="Left"
                                  Classes="event-expander"
                                  ToolTip.Tip="Expand the bounded observable request, response, tool parameters, tool result, or evidence for this event. Correlated operation halves appear together." />
                          <Border IsVisible="{Binding IsExpanded}"
                                  Background="#081321"
                                  BorderBrush="#3B6EA8"
                                  BorderThickness="2,0,0,0"
                                  Padding="9,7"
                                  CornerRadius="0,5,5,0">
                            <StackPanel Spacing="6">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding PayloadSummaryLabel}" Foreground="#72B6FF" FontSize="8" FontWeight="Bold" />
                                <Button Grid.Column="1" Content="{Binding ExpandControlText}" Command="{Binding ToggleExpandedCommand}"
                                        Classes="event-expander" ToolTip.Tip="Collapse this observable payload." />
                              </Grid>
                              <ItemsControl ItemsSource="{Binding PayloadSections}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:EventPayloadSectionViewModel">
                                    <StackPanel Margin="0,2,0,5" Spacing="3">
                                      <TextBlock Text="{Binding Label}" Foreground="#5AE4D2" FontSize="8" FontWeight="Bold" />
                                      <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <SelectableTextBlock Text="{Binding Text}" Foreground="#D0DBEA"
                                                             FontFamily="Cascadia Mono, Consolas" FontSize="9" TextWrapping="Wrap" />
                                      </ScrollViewer>
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <GridSplitter Grid.Row="2" Background="#26334A" ResizeDirection="Rows" />

              <Border Grid.Row="3" Classes="inner" Margin="0,8,0,0">
                <Grid>
                  <StackPanel IsVisible="{Binding !Timeline.HasSelectedEvent}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              MaxWidth="330"
                              Spacing="6"
                              ToolTip.Tip="Select a timeline card to inspect its bounded request, response, tool parameters/result, route, correlation identifier, and evidence.">
                    <TextBlock Text="NO EVENT SELECTED" Classes="eyebrow" HorizontalAlignment="Center" />
                    <TextBlock Text="Run or replay a mode, then select an event. Nothing is missing or treated as an empty response before a selection exists."
                               Foreground="#8799B5" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" />
                  </StackPanel>
                  <ScrollViewer IsVisible="{Binding Timeline.HasSelectedEvent}">
                  <StackPanel Spacing="7">
                    <TextBlock Text="SELECTED EVENT" Classes="eyebrow" />
                    <TextBlock Text="{Binding Timeline.SelectedEvent.Title}" Classes="heading" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Timeline.SelectedEvent.Route}" Foreground="#72B6FF" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Timeline.SelectedEvent.OperationId}" IsVisible="{Binding Timeline.SelectedEvent.HasOperationId}"
                               Foreground="#7087A7" FontFamily="Cascadia Mono, Consolas" FontSize="9" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Timeline.SelectedEvent.Detail}" Foreground="#B9C8DD" FontSize="10" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Timeline.SelectedEvent.PayloadAbsenceExplanation}"
                               IsVisible="{Binding Timeline.SelectedEvent.HasPayloadAbsenceExplanation}"
                               Foreground="#8799B5" FontSize="9" FontStyle="Italic" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Timeline.SelectedEvent.PayloadSections}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EventPayloadSectionViewModel">
                          <StackPanel Margin="0,3,0,7" Spacing="3">
                            <TextBlock Text="{Binding Label}" Foreground="#5AE4D2" FontSize="8" FontWeight="Bold" />
                            <SelectableTextBlock Text="{Binding Text}" Classes="mono" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="EVALUATION BOARD"
               ToolTip.Tip="Inspect typed eval-layer verdicts, mutation-control attempts, native null-baseline facts, and the exact local AgentEval run directory. This screen never rescales or re-scores them.">
        <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="10">
            <Border Classes="card" Padding="14"
                    ToolTip.Tip="This header updates as typed GateResult and ControlResult values arrive; it does not wait for the audience-paced event timeline to drain.">
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="220,*,Auto" ColumnSpacing="18" RowSpacing="8">
                <StackPanel>
                  <TextBlock Text="EVAL-LAYER VERDICT" Classes="eyebrow" />
                  <TextBlock Text="{Binding Evaluation.OverallStatus}" Foreground="{Binding Evaluation.OverallStatusColor}" FontSize="18" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="REGISTERED CONTROL COVERAGE" Classes="eyebrow"
                             ToolTip.Tip="The canonical panel contains 20 ProductionObservation rows and 23 BoundaryCalibrationFixture rows. Partial live counts stay partial." />
                  <TextBlock Text="{Binding Evaluation.ControlSummary}" Foreground="#F2F6FD" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" MinWidth="190" MaxWidth="300">
                  <TextBlock Text="LIVE PROGRESS" Classes="eyebrow" />
                  <TextBlock Text="{Binding Evaluation.RunProgress}" Foreground="#72B6FF" FontSize="11" FontWeight="SemiBold"
                             TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Evaluation.ActiveStage}" Foreground="#8FA3C0" FontSize="9" TextWrapping="Wrap" />
              </Grid>
            </Border>

            <Border Classes="card" Padding="14">
              <Grid ColumnDefinitions="1.2*,1.2*,1*" ColumnSpacing="16">
                <StackPanel Spacing="5">
                  <TextBlock Text="WHAT RUNS · DEMO SCOPE" Classes="eyebrow"
                             ToolTip.Tip="Offline Evals executes both use cases: Demo01's real agent/tool runtime with a deterministic client, and Demo02's real five-executor workflow in its zero-provider-model arm." />
                  <TextBlock Text="{Binding Evaluation.EvaluationScope}" Foreground="#C9D6E8" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="WHO EVALUATES" Classes="eyebrow"
                             ToolTip.Tip="AgentEval and the eval project own predicates, floors, observations, and verdicts. The Avalonia application only projects the typed results." />
                  <TextBlock Text="{Binding Evaluation.EvaluatorEngine}" Foreground="#C9D6E8" FontSize="10" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="5">
                  <TextBlock Text="MODEL CALLS · COST" Classes="eyebrow"
                             ToolTip.Tip="The default Offline Evals path uses no paid provider LLM. Deterministic fake-client boundaries may still emit model-call observations so the runtime contract can be tested." />
                  <TextBlock Text="{Binding Evaluation.ModelUsageSummary}" Foreground="#5AE4D2" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Classes="card" Padding="14"
                    ToolTip.Tip="Offline benchmark persistence uses AgentEval's FileSystemOutputStore. The path shown after completion is the exact run directory, not a friendly alias.">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="170,*" RowSpacing="5">
                <TextBlock Text="LOCAL AGENTEVAL RUN" Classes="eyebrow" />
                <SelectableTextBlock Grid.Column="1" Text="{Binding Evaluation.PersistenceSummary}" Foreground="#9FC5FF" FontFamily="Cascadia Mono, Consolas" FontSize="9" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="BENCHMARK FACTS" Classes="eyebrow" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Evaluation.BenchmarkSummary}" Foreground="#C9D6E8" FontSize="10" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="NULL DERIVATION" Classes="eyebrow"
                           ToolTip.Tip="The comparison bar and derivation come from the admitted AgentEval ChanceFloor. They describe the null model; they do not determine the UI verdict." />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Evaluation.BenchmarkFloorDerivation}" Foreground="#F6C55C" FontSize="10" TextWrapping="Wrap" />
                <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Evaluation.NullBaselineHelp}" Foreground="#8799B5" FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0" />
              </Grid>
            </Border>

            <Border Classes="inner" Padding="10"
                    IsVisible="{Binding IsCatalogueSelfTestMode}"
                    ToolTip.Tip="Catalogue integrity self-test is the former Ablation mode: it removes one row only from an isolated catalogue snapshot, expects process-equivalent exit 1, restores state, and uses no provider LLM.">
              <TextBlock Text="CATALOGUE INTEGRITY SELF-TEST · isolated catalogue row removed → detection expected (exit 1) → state restored · no provider LLM" Foreground="#B77CFF" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>

            <StackPanel Spacing="8" IsVisible="{Binding Evaluation.HasLiveEvaluation}">
              <Border Classes="card" Padding="12">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="180,*" RowSpacing="6">
                  <TextBlock Text="SELECTED LIVE PLAN" Classes="eyebrow" />
                  <TextBlock Grid.Column="1" Text="{Binding Evaluation.LivePlanTitle}" Foreground="#5AE4D2" FontSize="14" FontWeight="Bold" />
                  <TextBlock Grid.Row="1" Text="PURPOSE" Classes="eyebrow" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Evaluation.LivePlanDescription}" Foreground="#C9D6E8" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2" Text="WORKLOAD" Classes="eyebrow" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Evaluation.LiveWorkloadSummary}" Foreground="#F6C55C" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="3" Text="QUALITY PASS BAR" Classes="eyebrow"
                             ToolTip.Tip="The configured LLM quality score threshold. It is separate from each admitted check's chance floor, which is not derivable for these authored criteria." />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Evaluation.LiveQualityPassBar}" Foreground="#9FC5FF" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="4" Text="SESSION / OUTCOME" Classes="eyebrow" />
                  <StackPanel Grid.Row="4" Grid.Column="1">
                    <TextBlock Text="{Binding Evaluation.LiveSessionSummary}" Foreground="#AFC0D8" TextWrapping="Wrap" />
                    <SelectableTextBlock Text="{Binding Evaluation.LiveOutcomePath}" Classes="mono" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Row="5" Text="CONFIGURATION" Classes="eyebrow"
                             ToolTip.Tip="Immutable evaluator provenance: definition, judge fingerprint, bounded token settings, subject model relation, and—on Eval06—the redacted safety limits." />
                  <SelectableTextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Evaluation.LiveConfigurationSummary}" Classes="mono" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="6" Text="TYPED FAILURES" Classes="eyebrow"
                             ToolTip.Tip="Provider, cancellation, configuration, and safety execution failures remain explicit facts; they never become measured failures with score zero." />
                  <SelectableTextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Evaluation.LiveFailureSummary}" Foreground="#F6C55C" TextWrapping="Wrap" />
                </Grid>
              </Border>

              <Border Classes="card" Padding="10" IsVisible="{Binding Evaluation.HasLiveSafety}">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <TextBlock Text="SAFETY VERDICT" Classes="eyebrow" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Evaluation.LiveSafetyStatus}"
                               Foreground="{Binding Evaluation.LiveSafetyStatusColor}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                  </Grid>
                  <TextBlock Text="{Binding Evaluation.LiveSafetySummary}" Foreground="#C9D6E8" TextWrapping="Wrap" />
                  <TextBlock Text="The campaign can execute without producing a complete safety measurement. COMPROMISED means an attack succeeded; RESISTED is conclusive defence; clean ambiguity is NOT MEASURED; execution faults or incomplete coverage are INFRASTRUCTURE ERROR. Errored is a subset of Inconclusive—do not add those counts. No raw probe, response, extraction canary, system instruction, endpoint, or exception is stored."
                             Foreground="#AFC0D8" FontSize="9" TextWrapping="Wrap" />
                  <TextBlock Text="ATTACK-CATEGORY CENSUS" Classes="eyebrow" />
                  <ItemsControl ItemsSource="{Binding Evaluation.LiveSafetyAttacks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LiveSafetyAttackViewModel">
                        <Border Classes="listRow" Margin="0,0,0,5">
                          <Grid ColumnDefinitions="1.1*,1.4*,1.3*" ColumnSpacing="10">
                            <StackPanel><TextBlock Text="ATTACK / OWASP" Classes="eyebrow" /><TextBlock Text="{Binding Attack}" Foreground="#F3F7FD" /><TextBlock Text="{Binding OwaspId}" Classes="mono" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="OUTCOME" Classes="eyebrow" /><TextBlock Text="{Binding Outcome}" Foreground="{Binding OutcomeColor}" FontWeight="Bold" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="CENSUS" Classes="eyebrow" /><TextBlock Text="{Binding Total, StringFormat='total {0}'}" /><TextBlock Text="{Binding Resisted, StringFormat='resisted {0}'}" Classes="muted" /><TextBlock Text="{Binding Compromised, StringFormat='compromised {0}'}" Classes="muted" /><TextBlock Text="{Binding Inconclusive, StringFormat='inconclusive {0}'}" Classes="muted" /><TextBlock Text="{Binding Errored, StringFormat='errored subset {0}'}" Classes="muted" /></StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="REDACTED PROBE RECEIPTS" Classes="eyebrow" />
                  <ItemsControl ItemsSource="{Binding Evaluation.LiveSafetyProbes}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LiveSafetyProbeViewModel">
                        <Border Classes="listRow" Margin="0,0,0,5">
                          <Grid ColumnDefinitions="1.1*,1.4*,1.2*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                            <StackPanel><TextBlock Text="CATEGORY / PROBE" Classes="eyebrow" /><TextBlock Text="{Binding Attack}" Foreground="#F3F7FD" /><TextBlock Text="{Binding ProbeId}" Classes="mono" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="OUTCOME" Classes="eyebrow" /><TextBlock Text="{Binding OutcomeLabel}" Foreground="{Binding OutcomeColor}" FontWeight="Bold" TextWrapping="Wrap" /><TextBlock Text="{Binding ErrorKind, StringFormat='error kind: {0}'}" Classes="muted" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="ALLOW-LISTED FACTS" Classes="eyebrow" /><TextBlock Text="{Binding Severity, StringFormat='severity: {0}'}" /><TextBlock Text="{Binding Fidelity, StringFormat='fidelity: {0}'}" /><TextBlock Text="{Binding Technique, StringFormat='technique: {0}'}" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3"><TextBlock Text="SAFE DIAGNOSTIC" Classes="eyebrow" /><TextBlock Text="{Binding Diagnostic}" Foreground="#C9D6E8" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" IsVisible="{Binding HasFailure}" Spacing="3">
                              <TextBlock Text="TYPED PROBE FAILURE · ALLOW-LISTED" Classes="eyebrow" />
                              <Grid ColumnDefinitions="1*,1*,2*" ColumnSpacing="10">
                                <TextBlock Text="{Binding FailureStage, StringFormat='stage: {0}'}" Classes="mono" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding FailureCode, StringFormat='code: {0}'}" Classes="mono" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{Binding FailureDetail, StringFormat='detail: {0}'}" Foreground="#C9D6E8" TextWrapping="Wrap" />
                              </Grid>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="card" Padding="10" IsVisible="{Binding Evaluation.HasLiveScenarioAcceptances}">
                <StackPanel Spacing="6">
                  <TextBlock Text="TERMINAL ACCEPTANCE · PER-SCENARIO WILSON DECISIONS" Classes="eyebrow"
                             ToolTip.Tip="For stochastic plans, every arm and scenario must independently clear the configured Wilson lower-bound SLO. These rows—not pooled per-check rates—control the terminal verdict." />
                  <TextBlock Text="Every planned trial must be fully measured. A whole-trial success means its three required checks passed: use-case quality, response observed, and the arm-specific agent tool journal or workflow trace. Each arm/scenario group must independently clear the 95% Wilson lower-bound floor of 0.500. Pooled per-check reliability remains diagnostic." Classes="muted" TextWrapping="Wrap" />
                  <ItemsControl ItemsSource="{Binding Evaluation.LiveScenarioAcceptances}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LiveScenarioAcceptanceViewModel">
                        <Border Classes="listRow" Margin="0,0,0,5">
                          <Grid ColumnDefinitions="1.35*,0.9*,1*,1.15*,0.75*" ColumnSpacing="10">
                            <StackPanel><TextBlock Text="SCENARIO · ARM" Classes="eyebrow" /><TextBlock Text="{Binding Identity}" Foreground="#F3F7FD" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="CENSUS" Classes="eyebrow" /><TextBlock Text="{Binding Census}" Classes="muted" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="WHOLE-TRIAL SUCCESS / WILSON" Classes="eyebrow" TextWrapping="Wrap" /><TextBlock Text="{Binding Reliability}" Foreground="#D8E5F6" TextWrapping="Wrap" /><TextBlock Text="{Binding WilsonInterval}" Foreground="#F6C55C" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="REGISTERED POLICY" Classes="eyebrow" /><TextBlock Text="{Binding Policy}" Classes="muted" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="DECISION" Classes="eyebrow" /><TextBlock Text="{Binding Outcome}" Foreground="{Binding OutcomeColor}" FontWeight="Bold" /></StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="card" Padding="10" IsVisible="{Binding !Evaluation.HasLiveSafety}">
                <StackPanel Spacing="6">
                  <TextBlock Text="AUTHORED USE-CASE SCENARIOS · QUERY + CRITERIA" Classes="eyebrow"
                             ToolTip.Tip="These stable scenarios are selected before execution. Each carries its exact canonical customer query, expected behavior, and four scenario-specific judge criteria." />
                  <ItemsControl ItemsSource="{Binding Evaluation.LiveScenarios}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LiveScenarioPlanViewModel">
                        <Border Classes="listRow" Margin="0,0,0,5">
                          <Expander IsExpanded="True">
                            <Expander.Header>
                              <TextBlock Text="{Binding Title}" Foreground="#F3F7FD" FontWeight="SemiBold" />
                            </Expander.Header>
                            <StackPanel Margin="16,7,0,0" Spacing="5">
                              <TextBlock Text="{Binding Id}" Classes="mono" />
                              <TextBlock Text="{Binding Description}" Foreground="#AFC0D8" TextWrapping="Wrap" />
                              <TextBlock Text="EXPECTED BEHAVIOR" Classes="eyebrow" />
                              <TextBlock Text="{Binding ExpectedBehavior}" Foreground="#9FC5FF" TextWrapping="Wrap" />
                              <TextBlock Text="EXACT CUSTOMER QUERY" Classes="eyebrow" />
                              <SelectableTextBlock Text="{Binding Query}" Classes="mono" TextWrapping="Wrap" />
                              <TextBlock Text="JUDGE CRITERIA" Classes="eyebrow" />
                              <SelectableTextBlock Text="{Binding CriteriaSummary}" Foreground="#C9D6E8" FontSize="9" TextWrapping="Wrap" />
                              <TextBlock Text="GROUND-TRUTH FACTS" Classes="eyebrow" />
                              <SelectableTextBlock Text="{Binding GroundTruthFacts}" Foreground="#AFC0D8" FontSize="9" TextWrapping="Wrap" />
                              <TextBlock Text="AGENT TOOL / PRESENTED-SKU CONTRACT" Classes="eyebrow" />
                              <SelectableTextBlock Text="{Binding AgentToolExpectation}" Foreground="#AFC0D8" FontSize="9" TextWrapping="Wrap" />
                            </StackPanel>
                          </Expander>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="card" Padding="10" IsVisible="{Binding !Evaluation.HasLiveSafety}">
                <StackPanel Spacing="6">
                  <TextBlock Text="SUBJECT TRIALS · RESPONSE + TOOL / WORKFLOW EVIDENCE" Classes="eyebrow"
                             ToolTip.Tip="One row is one scenario, architecture, and repetition. Expand it to inspect the bounded sanitized model response and the typed tool or workflow observation." />
                  <TextBlock Text="Waiting for completed subject trials…" IsVisible="{Binding !Evaluation.HasLiveTrials}" Classes="muted" />
                  <ItemsControl ItemsSource="{Binding Evaluation.LiveTrials}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LiveTrialResultViewModel">
                        <Border Classes="listRow" Margin="0,0,0,5">
                          <Expander IsExpanded="False">
                            <Expander.Header>
                              <Grid ColumnDefinitions="150,*" Margin="16,0,0,0">
                                <TextBlock Text="{Binding Outcome}" Foreground="{Binding OutcomeColor}" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding Identity}" Foreground="#D8E5F6" TextWrapping="Wrap" />
                              </Grid>
                            </Expander.Header>
                            <StackPanel Margin="16,7,0,0" Spacing="5">
                              <TextBlock Text="SUBJECT STATUS / MEASUREMENT" Classes="eyebrow" />
                              <TextBlock Text="{Binding SubjectStatus}" Foreground="#9FC5FF" />
                              <TextBlock Text="{Binding Measurement}" Foreground="#9FC5FF" />
                              <TextBlock Text="SANITIZED RESPONSE PREVIEW" Classes="eyebrow" />
                              <SelectableTextBlock Text="{Binding ResponsePreview}" Classes="mono" TextWrapping="Wrap" />
                              <TextBlock Text="TOOL JOURNAL" Classes="eyebrow" />
                              <SelectableTextBlock Text="{Binding Tools}" Foreground="#AFC0D8" TextWrapping="Wrap" />
                              <TextBlock Text="WORKFLOW TRACE" Classes="eyebrow" />
                              <SelectableTextBlock Text="{Binding Workflow}" Foreground="#AFC0D8" TextWrapping="Wrap" />
                              <TextBlock Text="ADMITTED CHECKS" Classes="eyebrow" />
                              <SelectableTextBlock Text="{Binding Checks}" Foreground="#C9D6E8" FontSize="9" TextWrapping="Wrap" />
                              <TextBlock Text="USE-CASE CRITERION VERDICTS" Classes="eyebrow" />
                              <SelectableTextBlock Text="{Binding Criteria}" Foreground="#C9D6E8" FontSize="9" TextWrapping="Wrap" />
                              <TextBlock Text="TYPED TRIAL FAILURE" Classes="eyebrow" />
                              <SelectableTextBlock Text="{Binding Failure}" Foreground="#F6C55C" FontSize="9" TextWrapping="Wrap" />
                            </StackPanel>
                          </Expander>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="card" Padding="10" IsVisible="{Binding !Evaluation.HasLiveSafety}">
                <StackPanel Spacing="6">
                  <TextBlock Text="PER-ARM CHECK CENSUS + WILSON RELIABILITY" Classes="eyebrow"
                             ToolTip.Tip="Wilson intervals are reported per admitted check. A zero measured denominator remains NOT MEASURED; checks are never averaged into a flattering aggregate." />
                  <TextBlock Text="Waiting for per-check reliability facts…" IsVisible="{Binding !Evaluation.HasLiveChecks}" Classes="muted" />
                  <ItemsControl ItemsSource="{Binding Evaluation.LiveChecks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LiveCheckSummaryViewModel">
                        <Border Classes="listRow" Margin="0,0,0,5">
                          <Grid ColumnDefinitions="1.2*,1*,1*,1.2*" ColumnSpacing="10">
                            <StackPanel><TextBlock Text="CHECK · ARM" Classes="eyebrow" /><TextBlock Text="{Binding Name}" Foreground="#F3F7FD" TextWrapping="Wrap" /><TextBlock Text="{Binding ArmId}" Classes="mono" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="MEASUREMENT" Classes="eyebrow" /><TextBlock Text="{Binding Measurement}" Foreground="{Binding MeasurementColor}" /><TextBlock Text="{Binding Census}" Classes="muted" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="SUCCESS / TOTAL" Classes="eyebrow" /><TextBlock Text="{Binding Reliability}" Foreground="#D8E5F6" TextWrapping="Wrap" /></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="WILSON INTERVAL" Classes="eyebrow" /><TextBlock Text="{Binding WilsonInterval}" Foreground="#F6C55C" TextWrapping="Wrap" /></StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="card" Padding="10" IsVisible="{Binding Evaluation.HasLiveComparisons}">
                <StackPanel Spacing="6">
                  <TextBlock Text="AGENT VS WORKFLOW · PAIRED FACTS (NO UI WINNER)" Classes="eyebrow" />
                  <ItemsControl ItemsSource="{Binding Evaluation.LiveComparisons}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LiveComparisonViewModel">
                        <Border Classes="listRow" Margin="0,0,0,5">
                          <StackPanel Spacing="5">
                            <Grid ColumnDefinitions="1.2*,1*,1*,1*,1*" ColumnSpacing="10">
                              <StackPanel><TextBlock Text="CHECK" Classes="eyebrow" /><TextBlock Text="{Binding CheckName}" Foreground="#F3F7FD" TextWrapping="Wrap" /><TextBlock Text="{Binding Arms}" Classes="mono" TextWrapping="Wrap" /></StackPanel>
                              <StackPanel Grid.Column="1"><TextBlock Text="W / L / T" Classes="eyebrow" /><TextBlock Text="{Binding WinsLossesTies}" Foreground="#D8E5F6" /></StackPanel>
                              <StackPanel Grid.Column="2"><TextBlock Text="EFFECTIVE N / CENSUS" Classes="eyebrow" /><TextBlock Text="{Binding EffectiveN}" /><TextBlock Text="{Binding Census}" Classes="muted" TextWrapping="Wrap" /></StackPanel>
                              <StackPanel Grid.Column="3"><TextBlock Text="P / MIN ATTAINABLE P" Classes="eyebrow" /><TextBlock Text="{Binding PValue}" /><TextBlock Text="{Binding MinimumAttainableP}" Classes="muted" /></StackPanel>
                              <StackPanel Grid.Column="4"><TextBlock Text="COLLAPSED PASS-RATE DELTA / POWER" Classes="eyebrow" TextWrapping="Wrap" /><TextBlock Text="{Binding MeanDelta}" /><TextBlock Text="{Binding Power}" Foreground="#F6C55C" TextWrapping="Wrap" /></StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding ObservationUnit}" Classes="muted" TextWrapping="Wrap"
                                       ToolTip.Tip="The real statistical n is paired cases. AgentEval collapses repeated executions within each case; raw repetitions are not treated as independent samples." />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Classes="card" Padding="10">
                <StackPanel Spacing="6">
                  <TextBlock Text="PROVIDER USAGE + PHYSICAL RUN DIRECTORIES" Classes="eyebrow"
                             ToolTip.Tip="Missing provider usage stays NOT MEASURED. Every arm and repetition has a distinct AgentEval run directory, while the sanitized session outcome indexes them." />
                  <ItemsControl ItemsSource="{Binding Evaluation.LiveUsage}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LiveUsageViewModel">
                        <TextBlock Text="{Binding Summary}" Foreground="#9FC5FF" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding Evaluation.LiveRuns}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LiveRunReferenceViewModel">
                        <SelectableTextBlock Text="{Binding Summary}" Classes="mono" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding !Evaluation.HasLiveEvaluation}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="MANDATORY GATES + DIAGNOSTIC EVALUATIONS" Classes="eyebrow" />
                  <TextBlock Text="Authority is explicit on every row. Mandatory gates control the suite exit; diagnostic evaluations remain visible evidence but cannot fail it. Expand a row to inspect its subject, producer, evaluator, null baseline, and evidence." Classes="muted" FontSize="9" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Waiting for typed evaluation results…" IsVisible="{Binding !Evaluation.HasGates}" Foreground="#7184A1" FontSize="9" VerticalAlignment="Center" />
              </Grid>
              <ItemsControl ItemsSource="{Binding Evaluation.Gates}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:GateResultViewModel">
                    <Border Classes="card" Width="430" Margin="0,0,10,10" Padding="10">
                      <Expander IsExpanded="False"
                                ToolTip.Tip="Expand this typed gate result to see the observation boundary and evidence. The UI does not recalculate its verdict.">
                        <Expander.Header>
                          <Grid ColumnDefinitions="*,Auto" Width="374" Margin="16,0,0,0">
                            <StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding Authority}" Foreground="{Binding AuthorityColor}" FontSize="9" FontWeight="Bold" />
                                <TextBlock Text="·" Foreground="#7184A1" FontSize="9" />
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="Bold" />
                              </StackPanel>
                              <TextBlock Text="{Binding Name}" Foreground="#F3F7FD" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                              <TextBlock Text="OBSERVED VALUE" Classes="eyebrow" HorizontalAlignment="Right" />
                              <TextBlock Text="{Binding ObservedValue}" Foreground="#F3F7FD" FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </StackPanel>
                          </Grid>
                        </Expander.Header>
                        <Border Classes="inner" Margin="0,8,0,0">
                          <StackPanel Spacing="5">
                            <TextBlock Text="SUBJECT / SCOPE" Classes="eyebrow" />
                            <SelectableTextBlock Text="{Binding Scope}" Classes="mono" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                              <StackPanel>
                                <TextBlock Text="OBSERVATION PRODUCER" Classes="eyebrow" />
                                <SelectableTextBlock Text="{Binding Producer}" Classes="mono" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="ACCEPTANCE EVALUATOR" Classes="eyebrow" />
                                <SelectableTextBlock Text="{Binding Evaluator}" Classes="mono" TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                            <TextBlock Text="NULL / CHANCE BASELINE · NOT A PASS THRESHOLD" Classes="eyebrow"
                                       ToolTip.Tip="This value describes chance under the registered null model; it is not compared by this UI and is not a minimum passing score." />
                            <TextBlock Text="{Binding NullBaseline}" Foreground="#F6C55C" FontSize="10" />
                            <TextBlock Text="EVIDENCE" Classes="eyebrow" />
                            <SelectableTextBlock Text="{Binding Evidence}" Foreground="#AFC0D8" FontSize="9" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </Expander>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Border Classes="card" Padding="10" IsVisible="{Binding !Evaluation.HasLiveEvaluation}">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="MUTATION CONTROL RESULTS" Classes="eyebrow" />
                    <TextBlock Text="Every row runs the same evaluator three times: first healthy, then with one defect injected, then after recovery. A detected defect is the expected successful control outcome." Foreground="#AFC0D8" FontSize="9" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="No completed control rows yet." IsVisible="{Binding !Evaluation.HasControls}" Foreground="#7184A1" FontSize="9" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="64,1.2*,150,180,150" Margin="10,4,10,0" ColumnSpacing="8">
                  <TextBlock Text="ID" Classes="eyebrow" />
                  <TextBlock Grid.Column="1" Text="CONTROL · SCOPE" Classes="eyebrow" />
                  <TextBlock Grid.Column="2" Text="BASELINE HEALTHY" Classes="eyebrow"
                             ToolTip.Tip="The unmodified subject must first pass, proving the evaluator is healthy before a defect is planted." />
                  <TextBlock Grid.Column="3" Text="DEFECT-INJECTED · EXPECT DETECTION" Classes="eyebrow"
                             ToolTip.Tip="One registered mutation is planted. DETECTED is the expected successful outcome; MISSED means a wiring or sensitivity failure." />
                  <TextBlock Grid.Column="4" Text="RECOVERY" Classes="eyebrow"
                             ToolTip.Tip="The unmodified subject is evaluated again. RECOVERED confirms the same evaluator returned to its healthy result." />
                </Grid>
                <ItemsControl ItemsSource="{Binding Evaluation.Controls}" AutomationProperties.Name="Mutation control results">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ControlResultViewModel">
                      <Border Classes="listRow" Margin="0,0,0,5">
                        <Expander IsExpanded="False"
                                  ToolTip.Tip="Expand to inspect this diagnostic mutation's exact target, observation producer, acceptance evaluator, tranche, and evidence. Diagnostics are not admitted evals and do not carry chance floors.">
                          <Expander.Header>
                            <Grid ColumnDefinitions="56,1.2*,150,180,150" ColumnSpacing="8" Margin="16,0,0,0">
                              <TextBlock Text="{Binding Id}" Foreground="#7890AF" FontSize="10" VerticalAlignment="Center" />
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" Foreground="#E9F0FB" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Scope}" Foreground="#9FC5FF" FontSize="8" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding BaselineHealthy}" Foreground="{Binding BaselineColor}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="3" Text="{Binding DefectInjected}" Foreground="{Binding DefectColor}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="4" Text="{Binding Recovery}" Foreground="{Binding RecoveryColor}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                          </Expander.Header>
                          <Border Classes="inner" Margin="0,8,0,0">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*,*" ColumnSpacing="12" RowSpacing="7">
                              <StackPanel>
                                <TextBlock Text="SCOPE CLASS" Classes="eyebrow" />
                                <SelectableTextBlock Text="{Binding Scope}" Classes="mono" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="TARGET" Classes="eyebrow" />
                                <SelectableTextBlock Text="{Binding Target}" Classes="mono" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel Grid.Column="2">
                                <TextBlock Text="TRANCHE" Classes="eyebrow" />
                                <SelectableTextBlock Text="{Binding Tranche}" Classes="mono" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel Grid.Row="1">
                                <TextBlock Text="OBSERVATION PRODUCER" Classes="eyebrow" />
                                <SelectableTextBlock Text="{Binding Producer}" Classes="mono" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2">
                                <TextBlock Text="ACCEPTANCE EVALUATOR" Classes="eyebrow" />
                                <SelectableTextBlock Text="{Binding Evaluator}" Classes="mono" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                <TextBlock Text="EVIDENCE" Classes="eyebrow" />
                                <SelectableTextBlock Text="{Binding Evidence}" Foreground="#AFC0D8" FontFamily="Cascadia Mono, Consolas" FontSize="9" TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </Border>
                        </Expander>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="inner" Padding="10" IsVisible="{Binding !Evaluation.HasLiveEvaluation}">
              <StackPanel Spacing="4">
                <TextBlock Text="HISTORICAL HONESTY INTERPRETATION" Classes="eyebrow"
                           ToolTip.Tip="This is the eval layer's bounded interpretation of stated-need evidence and next-purchase evidence. Missing evidence remains NOT MEASURED." />
                <TextBlock Text="{Binding Evaluation.HonestClaims}" Foreground="#AFC0D8" FontSize="10" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="EVIDENCE BOUNDARY">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,10,0,0">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="WHAT THIS SCREEN MAY CLAIM" Classes="eyebrow" />
              <TextBlock Text="Observed execution" Classes="heading" FontSize="18" />
              <TextBlock Text="Model requests and responses are captured at the IChatClient boundary. Tool starts arrive before the real AIFunction is awaited; completions arrive afterward. Demo02 events are published by the real five-executor workflow. Evaluation verdicts arrive as typed GateResult and ControlResult objects." Foreground="#BCCAE0" TextWrapping="Wrap" />
              <TextBlock Text="Graph provenance" Classes="heading" FontSize="15" Margin="0,8,0,0" />
              <TextBlock Text="Demo01 nodes come from RecommendationAgentFactory.BuildReadOnlyTools(). Demo02 nodes and edges come from AgentEval.MAF over the exact prepared Workflow. The diagram is not an authored truth source." Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Text="WHAT THIS SCREEN WILL NOT DO" Classes="eyebrow" />
              <TextBlock Text="No self-examination" Classes="heading" FontSize="18" />
              <TextBlock Text="The artifact under test supplies no acceptance predicate, chance floor, or pass/fail input. The UI maps results; it does not grade them." Foreground="#BCCAE0" TextWrapping="Wrap" />
              <TextBlock Text="No secret or hidden-reasoning surface" Classes="heading" FontSize="15" Margin="0,8,0,0" />
              <TextBlock Text="API keys, endpoint URLs, raw safety probes/responses, canaries, system instructions, and exception details are structurally excluded or redacted before storage. Hidden chain-of-thought is never requested or displayed. Clean ambiguity remains NOT MEASURED; typed execution or configuration faults remain INFRASTRUCTURE ERROR—neither becomes score zero." Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="3" Background="#090F1A" BorderBrush="#202C41" BorderThickness="0,1,0,0" Padding="14,7">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="actual runtime → typed events → append-only store → paced UI projection" Foreground="#74839B" FontSize="9" />
        <TextBlock Grid.Column="1" Text="No hidden chain-of-thought · no endpoint or key output · deployment name only" Foreground="#52627A" FontSize="9" />
      </Grid>
    </Border>
  </Grid>
</Window>
