<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AgentEval.VitrineDemo.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="Background" Value="#08111F" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip.ShowDelay" Value="650" />
      <Setter Property="ToolTip.BetweenShowDelay" Value="-1" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.36" />
      <Setter Property="Background" Value="#111827" />
      <Setter Property="BorderBrush" Value="#273247" />
      <Setter Property="Foreground" Value="#67758C" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="ToggleSwitch">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip.ShowDelay" Value="650" />
      <Setter Property="ToolTip.BetweenShowDelay" Value="-1" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip.ShowDelay" Value="650" />
      <Setter Property="ToolTip.BetweenShowDelay" Value="-1" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="ToolTip.ShowDelay" Value="650" />
      <Setter Property="ToolTip.BetweenShowDelay" Value="-1" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#3478F6" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#3B2029" />
      <Setter Property="BorderBrush" Value="#8B3F52" />
      <Setter Property="Foreground" Value="#FFAFBC" />
    </Style>
    <Style Selector="Button.event-expander">
      <Setter Property="Background" Value="#17243A" />
      <Setter Property="BorderBrush" Value="#30496F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#9FC5FF" />
      <Setter Property="FontSize" Value="8" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="7,3" />
      <Setter Property="MinHeight" Value="22" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#111827" />
      <Setter Property="BorderBrush" Value="#25324A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.inner">
      <Setter Property="Background" Value="#0B1422" />
      <Setter Property="BorderBrush" Value="#22324B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.listRow">
      <Setter Property="Background" Value="#0D1726" />
      <Setter Property="BorderBrush" Value="#21314A" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Border.eventCard">
      <Setter Property="Background" Value="#0D1828" />
      <Setter Property="BorderBrush" Value="#263A57" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="#12332F" />
      <Setter Property="BorderBrush" Value="#327D73" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#7F91AE" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="1.1" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="Foreground" Value="#F5F8FF" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#91A0B8" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="Foreground" Value="#90A7C8" />
      <Setter Property="FontSize" Value="9" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="ToolTip.ShowDelay" Value="650" />
      <Setter Property="ToolTip.BetweenShowDelay" Value="-1" />
    </Style>
  </Application.Styles>
</Application>
